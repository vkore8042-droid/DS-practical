#include <stdio.h>
#define SIZE 10
#define EMPTY -1
#define DELETED -2
int table[SIZE];
// Initialize hash table
void initialize() {
    int i;
    for (i = 0; i < SIZE; i++) {
        table[i] = EMPTY;
    }
}
// Insert operation
void insert(int key) {
    int index = key % SIZE;
    int i, pos;
    for (i = 0; i < SIZE; i++) {
        pos = (index + i) % SIZE;
        if (table[pos] == key) {
            printf("Key already exists\n");
            return;
        }
        if (table[pos] == EMPTY || table[pos] == DELETED) {
            table[pos] = key;
            printf("Inserted successfully\n");
            return;
        }
    }
    printf("Hash table is full\n");
}
// Search operation
void search(int key) {
    int index = key % SIZE;
    int i, pos;
    for (i = 0; i < SIZE; i++) {
        pos = (index + i) % SIZE;
        if (table[pos] == EMPTY)
            break;
        if (table[pos] == key) {
            printf("Key found at index %d\n", pos);
            return;
        }
    }
    printf("Key not found\n");
}
// Delete operation
void deleteKey(int key) {
    int index = key % SIZE;
    int i, pos;
    for (i = 0; i < SIZE; i++) {
        pos = (index + i) % SIZE;
        if (table[pos] == EMPTY)
            break;
        if (table[pos] == key) {
            table[pos] = DELETED;
            printf("Deleted successfully\n");
            return;
        }
    }
}
    printf("Key not found\n");
// Display operation
void display() {
    int i;
    for (i = 0; i < SIZE; i++) {
        printf("%d : ", i);
        if (table[i] == EMPTY)
            printf("EMPTY");
        else if (table[i] == DELETED)
            printf("DELETED");
        else
            printf("%d", table[i]);
        printf("\n");
    }
}
// Main function
int main() {
    int ch, key;
    initialize();
    while (1) {
        printf("\n--- LINEAR PROBING ---\n");
        printf("1. Insert\n");
        printf("2. Search\n");
        printf("3. Delete\n");
        printf("4. Display\n");
        printf("5. Exit\n");
        printf("Enter choice: ");
        scanf("%d", &ch);
        switch (ch) {
            case 1:
                printf("Enter key: ");
                scanf("%d", &key);
                insert(key);
                break;
            case 2:
                printf("Enter key: ");
                scanf("%d", &key);
                search(key);
                break;
            case 3:
                printf("Enter key: ");
                scanf("%d", &key);
                deleteKey(key);
                break;
            case 4:
                display();
                break;
            case 5:
                return 0;
            default:
                printf("Invalid choice\n");
        }
    }
    return 0;
}
