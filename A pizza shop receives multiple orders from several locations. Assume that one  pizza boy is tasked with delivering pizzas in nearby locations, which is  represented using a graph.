#include <stdio.h>
#define MAX 10
int graph[MAX][MAX];
int visited[MAX];
int path[MAX + 1];
int bestPath[MAX + 1];
int n;
int minCost = 999999;
// TSP function
void tsp(int city, int count, int cost) {
    int i;
    if (count == n) {
        int total = cost + graph[city][0];
        if (total < minCost) {
            minCost = total;
            for (i = 0; i < n; i++) {
                bestPath[i] = path[i];
            }
            bestPath[n] = 0;
        }
        return;
    }
    for (i = 1; i < n; i++) {
        if (!visited[i]) {
            visited[i] = 1;
            path[count] = i;
            tsp(i, count + 1, cost + graph[city][i]);
            visited[i] = 0;
        }
    }
}
// Main function
int main() {
    int i, j;
    printf("Enter number of locations: ");
    scanf("%d", &n);
    if (n < 2 || n > MAX) {
        printf("Invalid number of locations\n");
        return 0;
    }
    printf("Enter distance matrix:\n");
    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &graph[i][j]);
            if (graph[i][j] < 0) {
                printf("Distance cannot be negative\n");
                return 0;
            }
        }
    }
    visited[0] = 1;
    path[0] = 0;
    tsp(0, 1, 0);
    printf("\nMinimum delivery distance: %d\n", minCost);
    printf("Best delivery path: ");
    for (i = 0; i <= n; i++) {
        printf("%d ", bestPath[i]);
    }
    printf("\n");
}
    return 0;
