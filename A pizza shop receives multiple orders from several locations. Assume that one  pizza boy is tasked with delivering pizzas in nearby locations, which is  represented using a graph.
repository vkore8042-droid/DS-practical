#include <stdio.h>
#include <string.h>
#define MAX 20

char name[MAX][20] = {"Shop"};
int g[MAX][MAX];
int n = 1;

int find(char *s) {
    int i;
    for (i = 0; i < n; i++)
        if (strcmp(name[i], s) == 0)
            return i;
    strcpy(name[n], s);
    return n++;
}

void dijkstra(int src, int d[]) {
    int done[MAX] = {0}, i, c;
    for (i = 0; i < n; i++)
        d[i] = 9999;
    d[src] = 0;
    for (c = 0; c < n; c++) {
        int u = -1;
        for (i = 0; i < n; i++)
            if (!done[i] && (u == -1 || d[i] < d[u]))
                u = i;
        done[u] = 1;
        for (i = 0; i < n; i++)
            if (g[u][i] && d[u] + g[u][i] < d[i])
                d[i] = d[u] + g[u][i];
    }
}

void deliver() {
    int m, i, cur = 0, total = 0, d[MAX], pending[MAX] = {0};
    char s[20];
    printf("Number of orders: ");
    scanf("%d", &m);
    for (i = 0; i < m; i++) {
        printf("Location: ");
        scanf("%s", s);
        pending[find(s)] = 1;
    }
    printf("Route: Shop");
    while (1) {
        int next = -1;
        dijkstra(cur, d);
        for (i = 1; i < n; i++)
            if (pending[i] && (next == -1 || d[i] < d[next]))
                next = i;
        if (next == -1)
            break;
        total += d[next];
        pending[next] = 0;
        cur = next;
        printf(" -> %s", name[next]);
    }
    printf("\nTotal distance: %d km\n", total);
}

int main() {
    int ch, i, j, w;
    char a[20], b[20];
    while (1) {
        printf("\n1.Add Road 2.Display Map 3.Plan Delivery 4.Exit\nChoice: ");
        scanf("%d", &ch);
        if (ch == 1) {
            printf("From: ");
            scanf("%s", a);
            printf("To: ");
            scanf("%s", b);
            printf("Distance (km): ");
            scanf("%d", &w);
            i = find(a);
            j = find(b);
            g[i][j] = g[j][i] = w;
        } else if (ch == 2) {
            for (i = 0; i < n; i++) {
                printf("%s: ", name[i]);
                for (j = 0; j < n; j++)
                    if (g[i][j])
                        printf("%s(%d) ", name[j], g[i][j]);
                printf("\n");
            }
        } else if (ch == 3)
            deliver();
        else if (ch == 4)
            break;
    }
    return 0;
}
