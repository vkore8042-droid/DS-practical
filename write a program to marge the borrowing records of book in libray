n = int(input("Enter number of members: ")) 
 
books = [] 
 
if n <= 0: 
    print("Invalid number of members") 
else: 
    for i in range(n): 
        x = int(input("Enter books borrowed by member: ")) 
        books.append(x) 
 
    average = sum(books) / n 
    maximum = max(books) 
    minimum = min(books) 
    zero = books.count(0) 
 
    mode = max(set(books), key=books.count) 
 
    print("\n--- Library Records ---") 
    print("Average books borrowed:", average) 
    print("Maximum books borrowed:", maximum) 
    print("Minimum books borrowed:", minimum) 
    print("Members with zero borrowing:", zero) 
    print("Most frequent borrowing:", mode)
