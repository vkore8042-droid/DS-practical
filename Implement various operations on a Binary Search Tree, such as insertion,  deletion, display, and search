#include <stdio.h>
#include <stdlib.h>

struct node {
    int key;
    struct node *left, *right;
};

struct node *insert(struct node *root, int key) {
    if (root == NULL) {
        root = malloc(sizeof(struct node));
        root->key = key;
        root->left = root->right = NULL;
    } else if (key < root->key)
        root->left = insert(root->left, key);
    else
        root->right = insert(root->right, key);
    return root;
}

struct node *del(struct node *root, int key) {
    struct node *t;
    if (root == NULL) {
        printf("Not found\n");
        return NULL;
    }
    if (key < root->key)
        root->left = del(root->left, key);
    else if (key > root->key)
        root->right = del(root->right, key);
    else if (root->left == NULL) {
        t = root->right;
        free(root);
        return t;
    } else if (root->right == NULL) {
        t = root->left;
        free(root);
        return t;
    } else {
        t = root->right;
        while (t->left != NULL)
            t = t->left;
        root->key = t->key;
        root->right = del(root->right, t->key);
    }
    return root;
}

int search(struct node *root, int key) {
    while (root != NULL) {
        if (key == root->key)
            return 1;
        root = (key < root->key) ? root->left : root->right;
    }
    return 0;
}

void display(struct node *root) {
    if (root != NULL) {
        display(root->left);
        printf("%d ", root->key);
        display(root->right);
    }
}

int main() {
    struct node *root = NULL;
    int ch, key;
    while (1) {
        printf("\n1.Insert 2.Delete 3.Search 4.Display 5.Exit\nChoice: ");
        scanf("%d", &ch);
        if (ch == 5)
            break;
        if (ch >= 1 && ch <= 3) {
            printf("Key: ");
            scanf("%d", &key);
        }
        if (ch == 1) root = insert(root, key);
        else if (ch == 2) root = del(root, key);
        else if (ch == 3) printf(search(root, key) ? "Found\n" : "Not found\n");
        else if (ch == 4) { display(root); printf("\n"); }
    }
    return 0;
}
