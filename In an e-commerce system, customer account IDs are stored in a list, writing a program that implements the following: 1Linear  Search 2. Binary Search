# Binary Search 
 
n = int(input("Enter number of elements: ")) 
 
arr = [] 
 
for i in range(n): 
    x = int(input("Enter element: ")) 
    arr.append(x) 
 
arr.sort() 
 
print("Sorted array:", arr) 
 
key = int(input("Enter element to search: ")) 
 
low = 0 
high = n - 1 
found = False 
 
while low <= high: 
 
    mid = (low + high) // 2 
 
    if arr[mid] == key: 
        print("Element found at position:", mid + 1) 
        found = True 
        break 
 
    elif key < arr[mid]: 
        high = mid - 1 
 
    else: 
        low = mid + 1 
 
if not found: 
    print("Element not found") 
