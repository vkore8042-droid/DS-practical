doc = []
redo = []

while True:
    print("\n1.Make Change 2.Undo 3.Redo 4.Display 5.Exit")
    ch = input("Choice: ")
    if ch == '1':
        doc.append(input("Enter text: "))
        redo.clear()
    elif ch == '2':
        if doc:
            redo.append(doc.pop())
        else:
            print("Nothing to undo")
    elif ch == '3':
        if redo:
            doc.append(redo.pop())
        else:
            print("Nothing to redo")
    elif ch == '4':
        print("Document:", " ".join(doc))
    elif ch == '5':
        break
